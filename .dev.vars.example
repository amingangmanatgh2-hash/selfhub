# SelfHub — متغیرهای محیطی (اختیاری)
# کپی کنید به .dev.vars برای اجراي لوکال، و در Cloudflare هم‌نامشان را در
# Settings → Variables و Secrets ست کنید.

# نصب بدون پنل (headless): اگر این دو ست شده باشند، SelfHub خودش نصب می‌کند
BOT_TOKEN=
ADMIN_PASSWORD=

# کلید امضای کوکی پنل و رمزنگاری توکن ربات.
# اگر خالی بماند، یک کلید تصادفی ساخته و در Durable Object ذخیره می‌شود.
# ست‌کردنش در Secret باعث می‌شود با هر بار پاک‌شدن دیتا، نشست‌ها و توکن قابل بازیابی بمانند.
SECRET=

# فقط برای دیباگ محلی: با 1 شدن، مسیر /api/simulate باز می‌شود تا بتوانی
# update ساختگی تلگرام را بدون اکانت ربات تست کنی. در پروداکست این را ست نکن.
SIMULATE=
